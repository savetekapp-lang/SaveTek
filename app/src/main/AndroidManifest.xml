<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- الاتصال بالإنترنت للتحميل -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- معرفة نوع الاتصال (لخيار "الواي فاي فقط") -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- التحميل في الخلفية مع إشعار -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- تثبيت تحديثات التطبيق (يطلب أندرويد موافقة المستخدم عند أول تحديث) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- إبقاء المعالج يعمل أثناء التحميل والشاشة مطفأة -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- تبويب "فيديوهات الجهاز": قراءة فيديوهات الجوال محلياً فقط (يُطلب عند فتح التبويب أول مرة) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- أندرويد 14+: خيار "السماح بالوصول لفيديوهات محددة فقط" -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- أندرويد 12 وما قبله: إذن القراءة القديم -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- الكتابة في المعرض: نحتاجها فقط في أندرويد 9 وما قبله -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!--
        أمان:
        - allowBackup=false + قواعد استخراج البيانات: لا تُنسخ بيانات التطبيق احتياطياً ولا تُنقل لجهاز آخر.
        - usesCleartextTraffic=false + networkSecurityConfig: كل اتصالات التطبيق مشفّرة (HTTPS) فقط.
    -->
    <application
        android:name=".SaveTekApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaveTek"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <!-- فتح التطبيق من أيقونته -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ظهور التطبيق في قائمة "مشاركة" عند مشاركة رابط.
             هذه الشاشة الوحيدة المكشوفة (ضروري)، والنص المستلم يُفحص بدقة في MainActivity و UrlSafety -->

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- المشغّل الداخلي. configChanges تمنع إعادة تشغيل الفيديو من البداية عند تدوير الشاشة -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.SaveTek.Player"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- يسمح لشاشة التثبيت الخاصة بالنظام بقراءة ملف التحديث المحمَّل -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- خدمة التحميل في الخلفية -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- نحذف مستقبِلاً مكشوفاً تضيفه مكتبة androidx.profileinstaller (لأدوات المطوّرين فقط، غير ضروري) -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
